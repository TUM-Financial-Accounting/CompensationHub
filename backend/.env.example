# Copy to .env and fill in the keys you have. The assistant lists every model below and marks
# the ones whose key is missing as unavailable.

# OpenAI
OPENAI_API_KEY=

# Morpheus, the CIT's LLM service (Open WebUI, OpenAI-compatible under /api/v1; models listed at
# /api/v1/models). Docs: https://wiki.ito.cit.tum.de/bin/view/CIT/ITO/Docs/Services/LLM%20%2F%20KI%20(Morpheus)/
# Key: https://morpheus.cit.tum.de → Profile → Settings → Account → API keys
MORPHEUS_API_KEY=
# MORPHEUS_BASE_URL=https://morpheus.cit.tum.de/api/v1

# A local or chair-hosted model served by Ollama (no key needed): add e.g. ollama:qwen3:8b to
# LLM_MODELS below, and set the server's address if it is not this machine.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Models offered in the assistant, as provider:model_id; the first available one is the default
LLM_MODELS=openai:gpt-5-mini,morpheus:google/gemma-4-31B-it,morpheus:cyankiwi/Qwen3.8-Flash-Next-AWQ-INT4
# LLM_MODEL=openai:gpt-5-mini

# Postgres for the Feedback page and for the log of rows saved with Add data, which is replayed
# onto the files at startup (on Railway: ${{Postgres.DATABASE_URL}}); unset, Feedback is off and
# the files are the only copy of hand-entered rows
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Register and sign in with email and password (accounts in DATABASE_URL; the app sends no email).
# Unset SECRET_KEY: no sign-in, every visitor is the local admin.
# Signs session cookies and password links: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# Admins, comma-separated: they add data, mark feedback as done and manage accounts. Each gets an
# account at startup; one without a password finds a link in the server log. Registering does not
# check addresses, so add one only once you know its account is that person's.
# ADMIN_EMAILS=

# Set to 1 to switch off the Add data form's write routes for everyone, admins included
# READ_ONLY=1
